var populations = Array.from(document.querySelectorAll('span.population')).map(function(span) {
    return Number(span.textContent.replace(/,/g, ''));
});
var total = populations.reduce(function(sum, population) {
    return sum + population;
}, 0);
var average = total / populations.length;
